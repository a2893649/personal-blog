# ========== 环境变量示例 ==========
# 复制为 .env 并按需修改（不要提交真实 .env 到仓库）

# 必改项：请替换为足够随机的长字符串
SECRET_KEY=change-me-to-a-random-string
JWT_SECRET=change-me-to-another-random-string

# 数据库
# 本地/演示用 SQLite（默认，免配置）：
DATABASE_URL=sqlite:///blog.db
# 生产用 PostgreSQL（推荐）：
# DATABASE_URL=postgresql://blog_user:strong_password@localhost:5432/blogdb

# 初始管理员账号（仅在用户表为空时创建一次）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# 服务端口（gunicorn / 平台会读取）
PORT=5000

# CORS 来源：* 允许所有；生产可填前端域名，多个用逗号分隔
CORS_ORIGINS=*

# JWT 有效期（天）
JWT_EXP_DAYS=7
