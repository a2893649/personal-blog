[Unit]
Description=Personal Blog (Flask + gunicorn)
Documentation=https://github.com/a2893649/personal-blog
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=blog
Group=blog
WorkingDirectory=/opt/blog
EnvironmentFile=/opt/blog/.env
ExecStart=/opt/blog/venv/bin/gunicorn -w 4 -b 127.0.0.1:5000 wsgi:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=blog
LimitNOFILE=65535
# ---- 安全加固 ----
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/blog
# 如使用外部数据库（非本机 PostgreSQL），删除上面两行 After=/Wants=postgresql 即可

[Install]
WantedBy=multi-user.target
