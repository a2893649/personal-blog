# ============================================================
# 生产环境变量模板
# 复制为 /opt/blog/.env，权限设为 600，切勿提交到仓库
# （本项目 .gitignore 已忽略 .env）
# 密钥可用 openssl rand -hex 32 生成
# ============================================================

# ---- 密钥（务必改为足够随机的长字符串）----
SECRET_KEY=__GENERATE_WITH_openssl_rand_hex_32__
JWT_SECRET=__GENERATE_WITH_openssl_rand_hex_32__

# ---- 数据库（推荐 PostgreSQL；演示可用 SQLite）----
# PostgreSQL（与 setup-server.sh 自动创建的一致）：
DATABASE_URL=postgresql://blog_user:CHANGE_DB_PASSWORD@127.0.0.1:5432/blogdb
# 或 SQLite（免数据库服务，写入 /opt/blog/blog.db）：
# DATABASE_URL=sqlite:///blog.db

# ---- 初始管理员（仅当用户表为空时创建一次）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
ADMIN_EMAIL=you@example.com

# ---- 服务端口（gunicorn 内部监听，nginx 反代到它）----
PORT=5000

# ---- CORS：生产应限制为你的前端域名（多个逗号分隔）----
CORS_ORIGINS=https://__DOMAIN__

# ---- JWT 有效期（天）----
JWT_EXP_DAYS=7
